{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information on Vibez",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "username": { "type": "string", "description": "Handle or username" },
        "displayName": { "type": "string", "description": "Display name" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "bio": { "type": "string", "description": "Bio text" },
        "followerCount": { "type": "integer", "description": "Number of followers" },
        "followingCount": { "type": "integer", "description": "Number of followed accounts" },
        "likesCount": { "type": "integer", "description": "Total received likes" },
        "verified": { "type": "boolean", "description": "Verification badge" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["id", "username", "displayName"]
    },
    "Video": {
      "title": "Video",
      "description": "Short-form video post with creator metadata and video edit attributes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Video document ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "creatorName": { "type": "string", "description": "Creator display name" },
        "creatorUsername": { "type": "string", "description": "Creator username" },
        "creatorAvatar": { "type": "string", "description": "Creator avatar image URL" },
        "caption": { "type": "string", "description": "Caption with hashtags" },
        "videoUrl": { "type": "string", "description": "Video stream/media URL" },
        "thumbnailUrl": { "type": "string", "description": "Video poster thumbnail URL" },
        "musicTrack": { "type": "string", "description": "Audio sound name" },
        "musicArtist": { "type": "string", "description": "Audio artist" },
        "durationSeconds": { "type": "number", "description": "Duration in seconds" },
        "likesCount": { "type": "integer", "description": "Number of likes" },
        "commentsCount": { "type": "integer", "description": "Number of comments" },
        "sharesCount": { "type": "integer", "description": "Number of shares" },
        "filterApplied": { "type": "string", "description": "Visual filter applied" },
        "speedMultiplier": { "type": "number", "description": "Video playback speed" },
        "tags": { "type": "array", "description": "List of hashtags" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "videoUrl", "caption"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment left on a video post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID" },
        "videoId": { "type": "string", "description": "Video ID parent" },
        "userId": { "type": "string", "description": "Author UID" },
        "username": { "type": "string", "description": "Author username" },
        "userAvatar": { "type": "string", "description": "Author avatar" },
        "text": { "type": "string", "description": "Comment text" },
        "likesCount": { "type": "integer", "description": "Likes on this comment" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["videoId", "userId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Feed of public short-form videos"
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Video comment subcollection"
    }
  }
}
