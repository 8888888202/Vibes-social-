rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUser(data) {
      return data.id is string
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 30
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50
        && (!('bio' in data) || data.bio is string)
        && (!('avatarUrl' in data) || data.avatarUrl is string)
        && (!('followerCount' in data) || data.followerCount is int)
        && (!('followingCount' in data) || data.followingCount is int)
        && (!('likesCount' in data) || data.likesCount is int)
        && (!('verified' in data) || data.verified is bool)
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidVideo(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.videoUrl is string && data.videoUrl.size() > 0
        && data.caption is string && data.caption.size() <= 500
        && (!('creatorName' in data) || data.creatorName is string)
        && (!('creatorUsername' in data) || data.creatorUsername is string)
        && (!('creatorAvatar' in data) || data.creatorAvatar is string)
        && (!('musicTrack' in data) || data.musicTrack is string)
        && (!('musicArtist' in data) || data.musicArtist is string)
        && (!('durationSeconds' in data) || data.durationSeconds is number)
        && (!('likesCount' in data) || data.likesCount is int)
        && (!('commentsCount' in data) || data.commentsCount is int)
        && (!('sharesCount' in data) || data.sharesCount is int)
        && (!('filterApplied' in data) || data.filterApplied is string)
        && (!('speedMultiplier' in data) || data.speedMultiplier is number)
        && (!('tags' in data) || data.tags is list)
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidComment(data) {
      return data.videoId is string
        && data.userId is string && data.userId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 300
        && (!('username' in data) || data.username is string)
        && (!('userAvatar' in data) || data.userAvatar is string)
        && (!('likesCount' in data) || data.likesCount is int)
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidVideo(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && isValidVideo(request.resource.data))
        || (
          // Allow viewers to like/share or increment comment counts
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount'])
        )
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        );
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/videos/$(videoId)).data.userId == request.auth.uid);
      }
    }
  }
}
